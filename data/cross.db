{
   ["_binutils"] = {
      ["build"] = rc.configure,
      ["flags"] = {
         "--target=x86_64-unknown-linux-gnu",
         "--prefix=/tools",
         "--with-sysroot=/mnt",
         "--disable-nls",
         "--disable-werror",
         "--enable-default-execstack=no",
         "--enable-default-hash-style=gnu",
         "--enable-deterministic-archives",
         "--enable-gprofng=no",
         "--enable-new-dtags",
         "--enable-relro",
         "--without-system-zlib",
      },
   };
   ["_gcc15"] = {
      ["build"] = rc.configure,
      ["flags"] = {
         "--target=x86_64-unknown-linux-gnu",
         "--prefix=/tools",
         "--with-glibc-version=2.43",
         "--with-newlib=yes",
         "--without-headers",
         "--with-sysroot=/mnt",
         "--disable-fixincludes",
         "--disable-libatomic",
         "--disable-libgomp",
         "--disable-libquadmath",
         "--disable-libsanitizer",
         "--disable-libssp",
         "--disable-libstdcxx",
         "--disable-libvtv",
         "--disable-nls",
         "--disable-shared",
         "--disable-werror",
         "--disable-multilib",
         "--disable-bootstrap",
         "--enable-checking=assert",
         "--enable-clocale=gnu",
         "--enable-__cxa_atexit",
         "--enable-default-pie",
         "--enable-default-ssp",
         "--enable-initfini-array",
         "--enable-languages=c,c++",
         "--enable-threads=single",
         "--with-linker-hash-style=gnu",
         "--without-system-zlib",
         "--without-included-gettext",
      },
      ["prep"] = [[
         for x in gmp mpfr mpc isl; do 
            mkdir $x && tar -C $x -xf /var/cache/distfiles/$x* --strip=1;
         done
      ]],
      ["post"] = [[
         cat ../gcc/{limitx,glimits,limity}.h > _
         mv _ $(x86_64-unknown-linux-gnu-gcc -print-file-name=include/limits.h)
      ]],
   };
   ["glibc"] = {
      ["build"] = ok.mkdir("build") and ok.chdir("build") and rc.configure,
      ["flags"] = {
         "--prefix=/usr",
         "--host=x86_64-unknown-linux-gnu",
         "--build=x86_64-pc-linux-gnu",
         "--enable-kernel=6.12",
         "--enable-bind-now",
         "--enable-stack-protector=strong",
         "--exec-prefix=/",
         "--disable-nscd",
         "--with-headers=/mnt/usr/include",
      },
      ["prep"] = [[
         >>configparms printf "%s=/bin\n"   {,root}sbindir
         >>configparms printf "%s=/lib64\n" {slib,rtld,audit}dir
         sed -i 's:^lib=.*audit:lib='\''/lib64:' ./elf/sotruss.sh
      ]],
   };
   ["libxcrypt"] = {
      ["build"] = rc.configure,
      ["flags"] = {
         "--prefix=/usr",
         "--host=x86_64-unknown-linux-gnu",
         "--build=x86_64-pc-linux-gnu",
         "--enable-hashes=strong,glibc",
         "--enable-obsolete-api=no",
         "--disable-failure-tokens",
         "PERL=/opt/perl/bin/perl",
      },
   };
   ["libstdcxx"] = {
      ["build"] = ok.chdir("libstdc++-v3") and rc.configure,
      ["flags"] = {
         "--prefix=/usr",
         "--host=x86_64-unknown-linux-gnu",
         "--build=x86_64-pc-linux-gnu",
         "--with-gxx-include-dir=/tools/x86_64-unknown-linux-gnu/include/c++/15.3.0",
         "--disable-libstdcxx-pch",
         "--disable-multilib",
         "--enable-clocale=gnu",
         "--enable-tls",
      },
      ["prep"] = [[
         for x in gmp mpfr mpc isl; do 
            mkdir $x && tar -C $x -xf /var/cache/distfiles/$x* --strip=1;
         done
      ]],
   };
   ["m4"] = {
      ["build"] = rc.configure,
      ["flags"] = {
         "--prefix=/usr",
         "--host=x86_64-unknown-linux-gnu",
         "--build=x86_64-pc-linux-gnu",
      },
   };
   ["ncurses"] = {
      ["build"] = rc.configure,
      ["flags"] = {
         "--prefix=/usr",
         "--host=x86_64-unknown-linux-gnu",
         "--build=x86_64-pc-linux-gnu",
         "--disable-root-access",
         "--disable-root-environ",
         "--disable-rpath-hack",
         "--disable-setuid-environ",
         "--disable-stripping",
         "--enable-hard-tabs",
         "--enable-pc-files",
         "--enable-widec",
         "--with-cxx-shared",
         "--with-manpage-format=normal",
         "--with-ospeed=unsigned",
         "--without-ada",
         "--without-debug",
         "--without-normal",
         "--without-tests",
         "--with-pkg-config-libdir=/lib64/pkgconfig",
         "--with-shared",
         "--with-termlib=tinfo",
         "--with-xterm-kbs=DEL",
         "ac_cv_path_TIC=/mnt/tools/bin/tic",
         "AWK=gawk",
      },
      ["prep"] = [[
         mkdir build && cd build
         sh ../configure AWK=/bin/gawk
         make -C include
         make -C progs tic
         install progs/tic /mnt/tools/bin
      ]],
      ["post"] = [[
         cd /mnt/usr/include
         sed -i 's/^#if.*XOPEN.*$/#if 1/' curses.h
         cd /mnt/lib64
         ln -sf libncurses{w,}.so
      ]],
   };
   ["bash"] = {
      ["build"] = rc.configure,
      ["flags"] = {
         "--prefix=/usr",
         "--host=x86_64-unknown-linux-gnu",
         "--build=x86_64-pc-linux-gnu",
         "--without-bash-malloc",
      },
   };
   ["coreutils"] = {
      ["build"] = rc.configure,
      ["flags"] = {
         "--prefix=/usr",
         "--host=x86_64-unknown-linux-gnu",
         "--build=x86_64-pc-linux-gnu",
         "--enable-install-program=hostname",
         "--without-openssl",
         "FORCE_UNSAFE_CONFIGURE=1",
      },
   };
   ["diffutils"] = {
      ["build"] = rc.configure,
      ["flags"] = {
         "--prefix=/usr",
         "--host=x86_64-unknown-linux-gnu",
         "--build=x86_64-pc-linux-gnu",
         "gl_cv_func_strcasecmp_works=y",
      },
   };
   ["file"] = {
      ["build"] = rc.configure,
      ["flags"] = {
         "--prefix=/usr",
         "--host=x86_64-unknown-linux-gnu",
         "--build=x86_64-pc-linux-gnu",
      },
   };
   ["findutils"] = {
      ["build"] = rc.configure,
      ["flags"] = {
         "--prefix=/usr",
         "--host=x86_64-unknown-linux-gnu",
         "--build=x86_64-pc-linux-gnu",
      },
   };
   ["gawk"] = {
      ["build"] = rc.configure,
      ["flags"] = {
         "--prefix=/usr",
         "--host=x86_64-unknown-linux-gnu",
         "--build=x86_64-pc-linux-gnu",
      },
      ["prep"] = [[ sed -i 's/extras//' Makefile.in ]],
   };
   ["grep"] = {
      ["build"] = rc.configure,
      ["flags"] = {
         "--prefix=/usr",
         "--host=x86_64-unknown-linux-gnu",
         "--build=x86_64-pc-linux-gnu",
      },
   };
   ["gzip"] = {
      ["build"] = rc.configure,
      ["flags"] = {
         "--prefix=/usr",
         "--host=x86_64-unknown-linux-gnu",
         "--build=x86_64-pc-linux-gnu",
      },
   };
   ["make"] = {
      ["build"] = rc.configure,
      ["flags"] = {
         "--prefix=/usr",
         "--host=x86_64-unknown-linux-gnu",
         "--build=x86_64-pc-linux-gnu",
         "--without-guile",
      },
   };
   ["patch"] = {
      ["build"] = rc.configure,
      ["flags"] = {
         "--prefix=/usr",
         "--host=x86_64-unknown-linux-gnu",
         "--build=x86_64-pc-linux-gnu",
      },
   };
   ["sed"] = {
      ["build"] = rc.configure,
      ["flags"] = {
         "--prefix=/usr",
         "--host=x86_64-unknown-linux-gnu",
         "--build=x86_64-pc-linux-gnu",
      },
   };
   ["tar"] = {
      ["build"] = rc.configure,
      ["flags"] = {
         "--prefix=/usr",
         "--host=x86_64-unknown-linux-gnu",
         "--build=x86_64-pc-linux-gnu",
         "FORCE_UNSAFE_CONFIGURE=1",
      },
   };
   ["xz"] = {
      ["build"] = rc.configure,
      ["flags"] = {
         "--prefix=/usr",
         "--host=x86_64-unknown-linux-gnu",
         "--build=x86_64-pc-linux-gnu",
      },
   };
   ["lua"] = {
      ["build"] = rc.make,
      ["flags"] = {
         "CC=x86_64-unknown-linux-gnu-gcc -std=gnu99",
         "AR=x86_64-unknown-linux-gnu-ar rcu",
         "RANLIB= x86_64-unknown-linux-gnu-ranlib",
      },
   };
   ["lzlib"] = {
      ["build"] = rc.configure,
      ["flags"] = {
         "--prefix=/usr",
         "--libdir=/lib64",
         "--enable-shared",
         "--disable-static",
         "CC=x86_64-unknown-linux-gnu-gcc",
         "AR=x86_64-unknown-linux-gnu-ar",
      },
   };
   ["plzip"] = {
      ["build"] = rc.configure,
      ["flags"] = {
         "--prefix=/usr",
         "--bindir=/bin",
         "CXX=x86_64-unknown-linux-gnu-g++",
      },
   };
   ["zlib"] = {
      ["build"] = rc.cmake,
      ["flags"] = {
         "-DZLIB_BUILD_SHARED=ON",
         "-DZLIB_BUILD_TESTING=OFF",
         "-DZLIB_BUILD_STATIC=OFF",
         "-DZLIB_BUILD_MINIZIP=OFF",
      },
   };
   ["util-linux"] = {
      ["build"] = rc.configure,
      ["flags"] = {
         "--prefix=/usr",
         "--host=x86_64-unknown-linux-gnu",
         "--build=x86_64-pc-linux-gnu",
         "--disable-all-programs",
         "--enable-libblkid",
         "--enable-libfdisk",
         "--enable-libmount",
         "--enable-libsmartcols,uuid",
         "--enable-libuuid",
         "--exec-prefix=/",
         "--without-systemd",
         "--without-python",
      },
   };
   ["libressl"] = {
      ["build"] = rc.configure,
      ["flags"] = {
         "--prefix=/usr",
         "--host=x86_64-unknown-linux-gnu",
         "--build=x86_64-pc-linux-gnu",
         "--with-openssldir=/etc/ssl",
      },
   };
   ["pkgconf"] = {
      ["build"] = rc.configure,
      ["flags"] = {
         "--prefix=/usr",
         "--host=x86_64-unknown-linux-gnu",
         "--build=x86_64-pc-linux-gnu",
      },
   };
   ["binutils"] = {
      ["build"] = rc.configure,
      ["flags"] = {
         "--host=x86_64-unknown-linux-gnu",
         "--build=x86_64-pc-linux-gnu",
         "--prefix=/usr",
         "--enable-64-bit-bfd",
         "--enable-default-execstack=no",
         "--enable-default-hash-style=gnu",
         "--enable-deterministic-archives",
         "--enable-gprofng=no",
         "--enable-new-dtags",
         "--enable-relro",
         "--with-system-zlib",
      },
      ["prep"] = [[ sed '6031s/$add_dir//' -i ltmain.sh ]],
   };
   ["gcc15"] = {
      ["build"] = rc.configure,
      ["flags"] = {
         "--build=x86_64-pc-linux-gnu",
         "--host=x86_64-unknown-linux-gnu",
         "--target=x86_64-unknown-linux-gnu",
         "--prefix=/usr",
         "--libdir=/usr/libexec",
         "--with-build-sysroot=/mnt",
         "--disable-fixincludes",
         "--disable-libatomic",
         "--disable-libgomp",
         "--disable-libquadmath",
         "--disable-libsanitizer",
         "--disable-libssp",
         "--disable-libstdcxx-pch",
         "--disable-libvtv",
         "--disable-multilib",
         "--disable-bootstrap",
         "--enable-checking=assert",
         "--enable-clocale=gnu",
         "--enable-__cxa_atexit",
         "--enable-default-pie",
         "--enable-default-ssp",
         "--enable-initfini-array",
         "--enable-languages=c,c++",
         "--enable-static",
         "--enable-threads=posix",
         "--enable-tls",
         "--with-linker-hash-style=gnu",
         "--with-system-zlib",
         "--without-included-gettext",
         "LDFLAGS_FOR_TARGET=-L${PWD}/x86_64-unknown-linux-gnu/libgcc",
      },
      ["prep"] = [[
         sed -i '330i #include <stdbool.h>' gcc/config/i386/i386.h
         sed -i '/thread_header =/s/@.*@/gthr-posix.h/' \
           {libgcc,libstdc++-v3/include}/Makefile.in
         for x in gmp mpfr mpc isl; do 
            mkdir $x && tar -C $x -xf /var/cache/distfiles/$x* --strip=1;
         done
      ]],
   };
}
